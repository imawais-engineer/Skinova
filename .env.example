API_KEY=YOUCAM_API_KEY
SECRET_KEY=YOUCAM_SECRET_KEY
BASE_URL=https://yce-api-01.makeupar.com
SKINOVA_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate_with_openssl_rand_base64_32
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Skin Coach — Qwen / DashScope (server-side only, never expose on frontend)
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
COACH_LLM_MODEL=qwen3-max
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

# Optional aliases (override QWEN_* when set)
# COACH_LLM_API_KEY=
# COACH_LLM_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE_URL=

